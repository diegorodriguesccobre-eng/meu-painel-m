{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "precificacaoconduz",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "CATALOG_SELLER_ID": "311509489",
    "ML_ACCOUNT_CONTROLS": "true"
  },
  "d1_databases": [
    {
      "binding": "CATALOG_DB",
      "database_name": "conduz-cobre-catalogo",
      "database_id": "acb3c5df-1b28-4bb0-b7d0-6dace48333fb",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
