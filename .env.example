# Configure no painel da hospedagem: secrets no Cloudflare ou Functions no Netlify.
# Nunca use segredos reais neste arquivo.
ML_CLIENT_ID=seu_app_id
ML_CLIENT_SECRET=sua_chave_secreta
ML_SESSION_SECRET=gere_64_caracteres_hexadecimais_aleatorios
ML_REDIRECT_URI=https://SEU_SITE.workers.dev/api/ml/callback
