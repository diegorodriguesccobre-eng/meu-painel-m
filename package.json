{
  "name": "meu-painel-m",
  "version": "1.0.0",
  "private": true,
  "description": "Painel de precificação e kits para marketplaces, com dados locais no navegador.",
  "scripts": {
    "test": "node validar.cjs && node --test tests/*.test.cjs",
    "build": "npm test && node preparar-site.cjs",
    "check:cloudflare": "npm run build && wrangler deploy --dry-run --outdir .wrangler/check",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "dev:cloudflare": "npm run build && wrangler dev --local"
  },
  "engines": {
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/diegorodriguesccobre-eng/meu-painel-m.git"
  },
  "devDependencies": {
    "wrangler": "4.161.0"
  }
}
